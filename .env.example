# Copy to .env.local (never commit .env.local). All Torob calls are server-side.
TOROB_SEARCH_URL=
TOROB_DETAILS_URL=
TOROB_CITY_REVERSE_URL=
# Optional extra request headers, as JSON
TOROB_SEARCH_HEADERS={"Accept":"application/json"}
TOROB_SIMILAR_URL=
TOROB_PRICE_CHART_URL=
TOROB_CATEGORY_URL=
TOROB_OFFERS_URL=
TOROB_TRENDS_URL=
# Flights («ترب بلیت»). Search is POST (creates a search) + GET {url}/{id} (results).
FLIGHTS_SEARCH_URL=
FLIGHTS_CALENDAR_URL=
# Seller site base for the deep link, e.g. https://seller.example/flights/
FLIGHTS_SELLER_URL=
# Optional extra request headers, as JSON
FLIGHTS_SEARCH_HEADERS=
# Optional: natural-language query parsing with Claude. Without it the box uses the built-in parser.
ANTHROPIC_API_KEY=
